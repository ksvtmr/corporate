# iClever Corporate — environment variables
# Copy to .env.local for local overrides (.env.local is gitignored). Never put
# secrets in VITE_* variables: everything prefixed VITE_ is compiled into the
# public JavaScript bundle and visible to every visitor.
#
# Where each variable is set:
#   development  → .env.local on your computer
#   preview      → .github/workflows/ci.yml (job deploy-preview), fixed values
#   production   → .github/workflows/ci.yml (job deploy-production) + GitHub
#                  repository variables (Settings → Secrets and variables →
#                  Actions → Variables). See DEPLOYMENT.md.

# ── Browser bundle (public) ───────────────────────────────────────────────
# true  → built-in Mock API in the browser (demo data in localStorage, demo accounts)
# false → requests go to a real backend at VITE_API_BASE_URL
VITE_USE_MOCK=true

# Base URL of the real API (used when VITE_USE_MOCK=false). Relative paths
# such as /api are served by the same host (or by the dev proxy below).
VITE_API_BASE_URL=/api

# Public path the app is served from. "/" locally; "/corporate/" on GitHub Pages
# (set automatically by the pipeline).
# VITE_BASE=/

# development | preview | production — set by the pipeline; preview builds show a badge.
# VITE_DEPLOY_ENV=development

# Prefix for browser storage keys. Empty in development and production; previews
# use pr-<N> so they never touch production demo data. Set by the pipeline.
# VITE_STORAGE_NAMESPACE=

# Commit SHA stamped into <meta name="app-version">. Set by the pipeline.
# VITE_APP_VERSION=dev

# ── Dev server only (never sent to the browser) ───────────────────────────
# With VITE_USE_MOCK=false, requests to VITE_API_BASE_URL are proxied here.
# DEV_API_PROXY_TARGET=http://localhost:8000
